<section class="suji-science full-width" id="SujiScience-{{ section.id }}">
  <div class="suji-science__layout">
    <div class="suji-science__media">
      {% if section.settings.product_image != blank %}
        <picture>
          {% if section.settings.mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.mobile_image | image_url: width: 900 }}"
            >
          {% endif %}
          {{
            section.settings.product_image
            | image_url: width: 1400
            | image_tag:
              class: 'suji-science__image',
              loading: 'lazy',
              alt: section.settings.image_alt
          }}
        </picture>
      {% endif %}
    </div>

    <div class="suji-science__content">
      {% if section.settings.heading_first != blank or section.settings.heading_second != blank %}
        <h2 class="suji-science__heading">
          {% if section.settings.heading_first != blank %}
            <span>{{ section.settings.heading_first | escape }}</span>
          {% endif %}
          {% if section.settings.heading_second != blank %}
            <em class="suji-science__heading-emphasis">{{ section.settings.heading_second | escape }}</em>
          {% endif %}
        </h2>
      {% endif %}

      {% assign strength_count = 0 %}
      {% assign recovery_count = 0 %}
      {% for block in section.blocks %}
        {% if block.settings.category == 'strength' %}
          {% assign strength_count = strength_count | plus: 1 %}
        {% elsif block.settings.category == 'recovery' %}
          {% assign recovery_count = recovery_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      {% if strength_count > 0 %}
        <div class="suji-science__group">
          {% if section.settings.strength_heading != blank %}
            <h3 class="suji-science__group-heading">{{ section.settings.strength_heading | escape }}</h3>
          {% endif %}
          <div class="suji-science__metrics">
            {% for block in section.blocks %}
              {% if block.settings.category == 'strength' %}
                <div class="suji-science__metric" {{ block.shopify_attributes }}>
                  {% if block.settings.study_label != blank %}
                    <p class="suji-science__study">{{ block.settings.study_label | escape }}</p>
                  {% endif %}
                  {% if block.settings.value != blank %}
                    <p class="suji-science__value">{{ block.settings.value | escape }}</p>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <div class="suji-science__description">{{ block.settings.description }}</div>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if recovery_count > 0 %}
        <div class="suji-science__group">
          {% if section.settings.recovery_heading != blank %}
            <h3 class="suji-science__group-heading">{{ section.settings.recovery_heading | escape }}</h3>
          {% endif %}
          <div class="suji-science__metrics">
            {% for block in section.blocks %}
              {% if block.settings.category == 'recovery' %}
                <div class="suji-science__metric" {{ block.shopify_attributes }}>
                  {% if block.settings.study_label != blank %}
                    <p class="suji-science__study">{{ block.settings.study_label | escape }}</p>
                  {% endif %}
                  {% if block.settings.value != blank %}
                    <p class="suji-science__value">{{ block.settings.value | escape }}</p>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <div class="suji-science__description">{{ block.settings.description }}</div>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a class="suji-science__button" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span>
        </a>
      {% endif %}

      {% if section.settings.sources != blank %}
        <p class="suji-science__sources">{{ section.settings.sources | escape | newline_to_br }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .suji-science {
    background: #fff;
    color: #303030;
  }

  .suji-science *,
  .suji-science *::before,
  .suji-science *::after {
    box-sizing: border-box;
  }

  .suji-science__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    padding: 40px 64px;
  }

  .suji-science__media {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: #fff;
  }

  .suji-science__media picture {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .suji-science__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .suji-science__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    width: 100%;
    max-width: 464px;
    min-width: 0;
  }

  .suji-science__heading {
    margin: 0;
    font-size: clamp(34px, 3.4vw, 38px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .suji-science__heading span,
  .suji-science__heading-emphasis {
    display: block;
  }

  .suji-science__heading-emphasis {
    font-weight: inherit;
    font-style: italic;
  }

  .suji-science__group {
    width: 100%;
    min-width: 0;
  }

  .suji-science__group-heading {
    margin: 0 0 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid #999;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .suji-science__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 48px;
  }

  .suji-science__metric {
    min-width: 0;
  }

  .suji-science__study {
    margin: 0 0 2px;
    font-size: 13px;
    line-height: 1.4;
  }

  .suji-science__value {
    margin: 0 0 8px;
    font-size: clamp(44px, 4.6vw, 51px);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .suji-science__description {
    max-width: 30ch;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.45;
  }

  .suji-science__description p {
    margin: 0;
  }

  .suji-science__button {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 16px;
    padding: 8px 18px;
    border: 1px solid currentColor;
    border-radius: 100px;
    color: inherit;
    font-size: 14px;
    line-height: 1.2;
    text-decoration: none;
  }

  .suji-science__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .suji-science__sources {
    max-width: 65ch;
    margin: -24px 0 0;
    color: #666;
    font-size: 11px;
    line-height: 1.4;
  }

  @media (max-width: 749px) {
    .suji-science__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding: 32px 24px 40px;
    }

    .suji-science__media {
      height: 360px;
    }

    .suji-science__content {
      gap: 28px;
    }

    .suji-science__heading {
      font-size: clamp(30px, 8.2vw, 38px);
    }

    .suji-science__group-heading {
      margin-bottom: 16px;
    }

    .suji-science__metrics {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .suji-science__value {
      font-size: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Suji science results",
  "settings": [
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile product image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Product image description"
    },
    {
      "type": "text",
      "id": "heading_first",
      "label": "Heading first line",
      "default": "Backed by Science."
    },
    {
      "type": "text",
      "id": "heading_second",
      "label": "Heading second line",
      "default": "Proven by Results."
    },
    {
      "type": "text",
      "id": "strength_heading",
      "label": "Strength group heading",
      "default": "Build lasting strength in just 3 short sessions a week"
    },
    {
      "type": "text",
      "id": "recovery_heading",
      "label": "Recovery group heading",
      "default": "Clinically shown to speed up recovery"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See The Science"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "textarea",
      "id": "sources",
      "label": "Study references",
      "default": "¹Yasuda et al., 2010  ²Loenneke et al., 2012\n³Takarada et al., 2000  ⁴Hughes et al., 2017"
    }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Metric",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Research group",
          "options": [
            { "value": "strength", "label": "Strength" },
            { "value": "recovery", "label": "Recovery" }
          ],
          "default": "strength"
        },
        {
          "type": "text",
          "id": "study_label",
          "label": "Study label",
          "default": "In a clinical study"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Result value",
          "default": "2.0x"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Result description",
          "default": "<p>Describe the study result.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Suji science results",
      "blocks": [
        {
          "type": "metric",
          "settings": {
            "category": "strength",
            "study_label": "In a clinical study¹",
            "value": "2.0x",
            "description": "<p>muscle strength increase vs traditional low-load training</p>"
          }
        },
        {
          "type": "metric",
          "settings": {
            "category": "strength",
            "study_label": "In a systematic review²",
            "value": "3.2X",
            "description": "<p>greater muscle mass gains compared to walking or light training without Targeted Compression/BFR</p>"
          }
        },
        {
          "type": "metric",
          "settings": {
            "category": "recovery",
            "study_label": "In a recovery study³",
            "value": "78%",
            "description": "<p>faster muscle recovery time post-exercise with Targeted Compression/BFR compared to passive rest</p>"
          }
        },
        {
          "type": "metric",
          "settings": {
            "category": "recovery",
            "study_label": "In a clinical trial⁴",
            "value": "40-50%",
            "description": "<p>pain reduction reported in individuals with chronic musculoskeletal pain</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
