<section class="sui-hero full-width" id="SuiHero-{{ section.id }}">
     <div class="sui-hero__layout">
       <div class="sui-hero__content">
         <div class="sui-hero__intro">
           {% if section.settings.star_icon != blank or section.settings.rating != blank or section.settings.trust_text != blank %}
             <div class="sui-hero__trust">
               {% if section.settings.star_icon != blank %}
                 <span class="sui-hero__rating" role="img" aria-label="{{ section.settings.rating_label | escape }}">
                   {% for star in (1..section.settings.star_count) %}
                     <img
                       src="{{ section.settings.star_icon | image_url: width: 28 }}"
                       width="14"
                       height="13"
                       alt=""
                     >
                   {% endfor %}
                 </span>
               {% elsif section.settings.rating != blank %}
                 <span class="sui-hero__rating" aria-label="{{ section.settings.rating_label | escape }}">
                   {{ section.settings.rating | escape }}
                 </span>
               {% endif %}

               {% if section.settings.trust_text != blank %}
                 <span>{{ section.settings.trust_text | escape }}</span>
               {% endif %}
             </div>
           {% endif %}

           {% if section.settings.heading != blank or section.settings.heading_emphasis != blank %}
             <h2 class="sui-hero__heading">
               {% if section.settings.heading != blank %}
                 <span class="sui-hero__heading-line">{{ section.settings.heading | escape }}</span>
               {% endif %}
               {% if section.settings.heading_emphasis != blank %}
                 <em class="sui-hero__heading-line sui-hero__heading-emphasis">{{ section.settings.heading_emphasis | escape }}</em>
               {% endif %}
             </h2>
           {% endif %}

           {% if section.settings.description != blank %}
             <div class="sui-hero__description">
               {{ section.settings.description }}
             </div>
           {% endif %}

           {% if section.settings.primary_link != blank or section.settings.secondary_link != blank %}
             <div class="sui-hero__actions">
               {% if section.settings.primary_link != blank and section.settings.primary_label != blank %}
                 <a class="sui-hero__button sui-hero__button--primary" href="{{ section.settings.primary_link }}">
                   {{ section.settings.primary_label | escape }}
                 </a>
               {% endif %}

               {% if section.settings.secondary_link != blank and section.settings.secondary_label != blank %}
                 <a class="sui-hero__button sui-hero__button--secondary" href="{{ section.settings.secondary_link }}">
                   {{ section.settings.secondary_label | escape }}
                 </a>
               {% endif %}
             </div>
           {% endif %}

           {% if section.settings.guarantee_text != blank %}
             <p class="sui-hero__guarantee">
               {% if section.settings.guarantee_icon != blank %}
                 {{
                   section.settings.guarantee_icon
                   | image_url: width: 32
                   | image_tag:
                     class: 'sui-hero__guarantee-icon',
                     loading: 'lazy',
                     alt: ''
                 }}
               {% endif %}
               {{ section.settings.guarantee_text | escape }}
             </p>
           {% endif %}
         </div>

         {% if section.blocks.size > 0 %}
           <div class="sui-hero__benefits">
             {% for block in section.blocks %}
               <div class="sui-hero__benefit" {{ block.shopify_attributes }}>
                 {% if block.settings.icon != blank %}
                   {{
                     block.settings.icon
                     | image_url: width: 80
                     | image_tag:
                       class: 'sui-hero__benefit-icon',
                       loading: 'lazy',
                       alt: block.settings.icon_alt
                   }}
                 {% endif %}

                 {% if block.settings.text != blank %}
                   <span>{{ block.settings.text | escape }}</span>
                 {% endif %}
               </div>
             {% endfor %}
           </div>
         {% endif %}
       </div>

       <div class="sui-hero__media">
         {% if section.settings.desktop_image != blank %}
           <picture>
             {% if section.settings.mobile_image != blank %}
               <source
                 media="(max-width: 749px)"
                 srcset="{{ section.settings.mobile_image | image_url: width: 900 }}"
               >
             {% endif %}

             {{
               section.settings.desktop_image
               | image_url: width: 1800
               | image_tag:
                 class: 'sui-hero__image',
                 loading: 'eager',
                 alt: section.settings.image_alt
             }}
           </picture>
         {% endif %}
       </div>
     </div>
   </section>

   {% stylesheet %}
     .sui-hero {
       background: #F9F5F3;
       color: #252525;
     }

     .sui-hero *,
     .sui-hero *::before,
     .sui-hero *::after {
       box-sizing: border-box;
     }

     .sui-hero__layout {
       display: grid;
       grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
       width: min(100%, 1440px);
       min-height: 580px;
       margin-inline: auto;
     }

     .sui-hero__content {
       display: flex;
       flex-direction: column;
       justify-content: center;
       gap: 48px;
       min-width: 0;
       padding: 64px clamp(24px, 5vw, 88px);
     }

     .sui-hero__intro {
       max-width: 580px;
     }

     .sui-hero__trust {
       display: flex;
       flex-wrap: wrap;
       align-items: center;
       gap: 5px;
       font-size: 12px;
     }

     .sui-hero__rating {
       display: inline-flex;
       align-items: center;
       gap: 1px;
       color: #E10017;
       letter-spacing: 1px;
     }

     .sui-hero__rating img {
       display: block;
       width: 14px;
       height: 13px;
       object-fit: contain;
     }

     .sui-hero__heading {
       margin: 12px 0;
       font-size: clamp(32px, 3.4vw, 52px);
       font-weight: 500;
       letter-spacing: -0.035em;
       line-height: 1.2;
     }

     .sui-hero__heading-line {
       display: block;
     }

     .sui-hero__heading-emphasis {
       font-weight: inherit;
       font-style: italic;
     }

     @media (min-width: 1100px) {
       .sui-hero__heading-line {
         white-space: nowrap;
       }
     }

     .sui-hero__description {
       max-width: 43ch;
       font-size: 16px;
       line-height: 1.5;
     }

     .sui-hero__description p {
       margin: 0;
     }

     .sui-hero__actions {
       display: flex;
       flex-wrap: wrap;
       gap: 10px;
       margin-top: 24px;
     }

     .sui-hero__button {
       display: inline-flex;
       min-height: 44px;
       align-items: center;
       justify-content: center;
       padding: 10px 22px;
       border: 1px solid #E10017;
       border-radius: 100px;
       font-size: 14px;
       line-height: 1;
       text-align: center;
       text-decoration: none;
     }

     .sui-hero__button--primary {
       background: #E10017;
       color: #fff;
     }

     .sui-hero__button--secondary {
       background: #F9F5F3;
       color: #E10017;
     }

     .sui-hero__button:focus-visible {
       outline: 2px solid #252525;
       outline-offset: 3px;
     }

     .sui-hero__guarantee {
       display: flex;
       align-items: center;
       gap: 6px;
       margin: 12px 0 0;
       font-size: 12px;
     }

     .sui-hero__guarantee-icon {
       display: block;
       width: 16px;
       height: 16px;
       flex: none;
       object-fit: contain;
     }

     .sui-hero__benefits {
       display: flex;
       flex-wrap: wrap;
       gap: 20px;
     }

     .sui-hero__benefit {
       display: flex;
       flex: 1 1 130px;
       align-items: center;
       gap: 8px;
       min-width: 0;
       font-size: 12px;
       line-height: 1.3;
     }

     .sui-hero__benefit-icon {
       width: 40px;
       height: 42px;
       flex: none;
       object-fit: contain;
     }

     .sui-hero__media {
       min-width: 0;
       min-height: 580px;
       overflow: hidden;
       background: #F9F5F3;
     }

     .sui-hero__media picture {
       display: block;
       width: 100%;
       height: 100%;
     }

     .sui-hero__image {
       display: block;
       width: 100%;
       height: 100%;
       object-fit: contain;
     }

     @media (max-width: 749px) {
       .sui-hero__layout {
         display: flex;
         flex-direction: column;
         min-height: 0;
       }

       .sui-hero__media {
         order: -1;
         width: 100%;
         height: 450px;
         min-height: 0;
       }

       .sui-hero__content {
         gap: 34px;
         padding: 48px 24px;
       }

       .sui-hero__heading {
         font-size: clamp(30px, 9vw, 38px);
       }

       .sui-hero__benefits {
         flex-direction: column;
         gap: 18px;
       }

       .sui-hero__benefit {
         flex: none;
       }
     }
   {% endstylesheet %}

   {% schema %}
   {
     "name": "Suji hero",
     "settings": [
       {
         "type": "text",
         "id": "rating",
         "label": "Rating characters",
         "default": "★★★★★"
       },
       {
         "type": "text",
         "id": "rating_label",
         "label": "Rating accessible label",
         "default": "Five out of five stars"
       },
       {
         "type": "image_picker",
         "id": "star_icon",
         "label": "Rating star icon"
       },
       {
         "type": "range",
         "id": "star_count",
         "label": "Number of stars",
         "min": 1,
         "max": 5,
         "step": 1,
         "default": 5
       },
       {
         "type": "text",
         "id": "trust_text",
         "label": "Trust text",
         "default": "Trusted by 1,000+ happy customers"
       },
       {
         "type": "text",
         "id": "heading",
         "label": "Heading first line",
         "default": "Wake Up The"
       },
       {
         "type": "text",
         "id": "heading_emphasis",
         "label": "Heading emphasized line",
         "default": "Muscles That Matter."
       },
       {
         "type": "richtext",
         "id": "description",
         "label": "Description",
         "default": "<p>Suji delivers science-backed targeted compression — pain relief, muscle activation, and lasting strength in minutes, right from home.</p>"
       },
       {
         "type": "text",
         "id": "primary_label",
         "label": "Primary button label",
         "default": "Try Suji"
       },
       {
         "type": "url",
         "id": "primary_link",
         "label": "Primary button link"
       },
       {
         "type": "text",
         "id": "secondary_label",
         "label": "Secondary button label",
         "default": "How It Works"
       },
       {
         "type": "url",
         "id": "secondary_link",
         "label": "Secondary button link"
       },
       {
         "type": "text",
         "id": "guarantee_text",
         "label": "Guarantee text",
         "default": "30-day money back guarantee"
       },
       {
         "type": "image_picker",
         "id": "guarantee_icon",
         "label": "Guarantee icon"
       },
       {
         "type": "image_picker",
         "id": "desktop_image",
         "label": "Desktop image"
       },
       {
         "type": "image_picker",
         "id": "mobile_image",
         "label": "Mobile image"
       },
       {
         "type": "text",
         "id": "image_alt",
         "label": "Image description"
       }
     ],
     "blocks": [
       {
         "type": "benefit",
         "name": "Benefit",
         "settings": [
           {
             "type": "image_picker",
             "id": "icon",
             "label": "Icon"
           },
           {
             "type": "text",
             "id": "icon_alt",
             "label": "Icon description"
           },
           {
             "type": "text",
             "id": "text",
             "label": "Benefit text",
             "default": "Benefit"
           }
         ]
       }
     ],
     "max_blocks": 6,
     "presets": [
       {
         "name": "Suji hero",
         "blocks": [
           {
             "type": "benefit",
             "settings": {
               "text": "Activates muscles & builds strength"
             }
           },
           {
             "type": "benefit",
             "settings": {
               "text": "Boosts recovery & circulation"
             }
           },
           {
             "type": "benefit",
             "settings": {
               "text": "Supports healthy joints & movement"
             }
           }
         ]
       }
     ]
   }
   {% endschema %}